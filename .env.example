# CareFlow AI - local development configuration.
# Copy to .env and change values. Never commit real patient data or secrets.

# Storage
CAREFLOW_DATA_DIR=./data
CAREFLOW_DB_PATH=./data/careflow.db
CAREFLOW_ENCRYPTION_KEY=
# Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Model provider: sarvam | ollama | mock
# Sarvam (GLM-5.3) is the default. Ollama is retained only as a legacy
# self-hosted option. mock is deterministic and only for tests/offline demos.
CAREFLOW_LLM_PROVIDER=sarvam
# Sarvam cloud API. Required for LLM extraction, OCR, speech and voice.
# Keep it in .env, never in source control.
SARVAM_API_KEY=
CAREFLOW_SARVAM_BASE_URL=https://api.sarvam.ai
CAREFLOW_SARVAM_CHAT_MODEL=glm5.3
CAREFLOW_SARVAM_TIMEOUT_S=120
CAREFLOW_SARVAM_MAX_TOKENS=4096
CAREFLOW_SARVAM_REASONING_EFFORT=low
# Sarvam Vision OCR. Leave the model blank to use the digitise pipeline's
# current default; the public "sarvam-vision" alias is not a valid override.
CAREFLOW_OCR_MODEL=
# Optional BCP-47 language hint, e.g. en-IN or hi-IN. Blank lets Sarvam use
# its Indic default.
CAREFLOW_OCR_LANGUAGE=
# printed | handwritten | mixed. "printed" preserves individual layout blocks.
CAREFLOW_OCR_CONTENT_TYPE=printed
CAREFLOW_OCR_TIMEOUT_S=300
CAREFLOW_OCR_REQUEST_TIMEOUT_S=120
CAREFLOW_OCR_POLL_S=2
# Bulbul text-to-speech and patient voice experience
CAREFLOW_TTS_MODEL=bulbul:v3
CAREFLOW_TTS_SPEAKER=shubh
CAREFLOW_TTS_TIMEOUT_S=60
CAREFLOW_PATIENT_VOICE_MAX_CHARS=12000

# Legacy local Ollama provider (only used when CAREFLOW_LLM_PROVIDER=ollama).
# CAREFLOW_OLLAMA_BASE_URL=http://127.0.0.1:11434
# CAREFLOW_OLLAMA_MODEL=qwen3:8b
# CAREFLOW_OLLAMA_TIMEOUT_S=300
# CAREFLOW_OLLAMA_NUM_CTX=8192
# CAREFLOW_OLLAMA_KEEP_ALIVE=30m
# CAREFLOW_OLLAMA_TEMPERATURE=0.0
CAREFLOW_MODEL_RETRIES=2
CAREFLOW_MODEL_BACKOFF_S=0.5

# Pipeline
CAREFLOW_PROCESSING_MODE=background
CAREFLOW_MAX_WORKERS=2
CAREFLOW_MAX_UPLOAD_BYTES=20971520
CAREFLOW_RULES_PATH=./app/triage/rules_demo.json

# Access control: dev | api_key
# dev mode trusts X-User-Id, X-Role and X-Patient-Id headers. Use only on a
# trusted local machine. api_key mode requires X-API-Key.
CAREFLOW_AUTH_MODE=dev
# key:role:user_id,key2:role2:user_id2
CAREFLOW_API_KEYS=

CAREFLOW_RETENTION_DAYS=365
CAREFLOW_SOURCE_ACCESS_AUDIT=true

# Patient communication, follow-up and urgent escalation delivery.
# outbox: auditable local outbox (default) | webhook: POST JSON | fail: drills
CAREFLOW_COMMUNICATION_DELIVERY=outbox
CAREFLOW_ESCALATION_DELIVERY=outbox
CAREFLOW_OUTBOUND_WEBHOOK_URL=
CAREFLOW_OUTBOUND_TIMEOUT_S=10
# Wait estimates stay unavailable until this many observed reviews exist.
CAREFLOW_WAIT_ESTIMATE_MIN_SAMPLE=3

# Direct intake: STT, translation, OCR and the organizer run in-process.
# Sarvam is a cloud API: source audio, documents and prompts leave this machine
# when these features are used. Keep SARVAM_API_KEY in .env only.
# Optional: defaults to sarvam-translate:v1.
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# Upper bound on how long CareFlow waits for the blocking Sarvam call.
CAREFLOW_STT_TIMEOUT_S=120
